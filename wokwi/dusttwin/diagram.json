    { "type": "wokwi-potentiometer", "id": "pm1", "top": -25, "left": -270, "attrs": { "value": "250" } },
    { "type": "wokwi-potentiometer", "id": "pm2", "top": 115, "left": -270, "attrs": { "value": "360" } },
    { "type": "wokwi-dht22", "id": "dht", "top": 85, "left": 310, "attrs": {} },
