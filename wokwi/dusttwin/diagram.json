    [ "pm1:VCC", "esp:3V3", "red", [ "h46", "v-12" ] ],
    [ "pm1:GND", "esp:GND.1", "black", [ "h59", "v4" ] ],
    [ "pm2:SIG", "esp:D35", "blue", [ "h34", "v11" ] ],
