    { "type": "wokwi-text", "id": "pm1Label", "top": -80, "left": -300, "attrs": { "text": "PM Sensor 1 (Simulated)\nAnalog concentration input" } },
    { "type": "wokwi-text", "id": "pm2Label", "top": 60, "left": -300, "attrs": { "text": "PM Sensor 2 (Simulated)\nAnalog concentration input" } },
